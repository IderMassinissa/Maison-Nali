SESSION_SECRET=
PORT=3001

# URL du front, utilisée pour configurer le CORS. Obligatoire en
# production (le serveur refuse de démarrer sans elle si NODE_ENV=production).
# En dev, valeur par défaut si absente : http://localhost:5173
FRONT_URL=http://localhost:5173

# A activer (TRUST_PROXY=true) seulement si le serveur tourne derrière un
# reverse proxy (nginx, l'hébergeur choisi...) qui termine le HTTPS avant de
# relayer la requête. Désactivé par défaut.
TRUST_PROXY=false
